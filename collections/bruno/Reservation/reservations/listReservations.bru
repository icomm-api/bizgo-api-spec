meta {
  name: 예약 목록 조회 (listReservations)
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/comm/v1/reservation/list?resvSendTime=2026-05-01 10:00:00
  body: none
  auth: inherit
}

params:query {
  resvSendTime: 2026-05-01 10:00:00
  ~paymentCode: PAYMENT_CODE_EXAMPLE
  ~lastSeq: 1
  ~limit: 1
}

docs {
  **예약 목록 조회** — `GET /api/comm/v1/reservation/list`

  예약 발송 건 목록을 조회합니다. `resvSendTime`에 지정한 시각을 포함해 그 이후의 예약 건이 조회됩니다.

  - operationId: `listReservations`
  - SDK: `reservations.list`
  - 원문: https://developers.bizgo.io/api-sdk/api-reference/comm/reservation
}
