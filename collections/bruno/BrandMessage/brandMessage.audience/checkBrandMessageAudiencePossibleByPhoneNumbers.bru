meta {
  name: 발송 예상 모수 확인 (전화번호 명단 기반) (checkBrandMessageAudiencePossibleByPhoneNumbers)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/comm/v1/center/brandmessage/groupMessage/friend/possible
  body: json
  auth: inherit
}

body:json {
  {
    "senderKey": "SENDER_KEY_EXAMPLE",
    "phoneNumbers": [
      "01000000000",
      "01000000000",
      "01000000000",
      "01000000000",
      "01000000000",
      "01000000000",
      "01000000000",
      "01000000000",
      "01000000000",
      "01000000000"
    ]
